{{define "bootstrap.tmpl"}}{{template "header" .}}
<section class="hero">
  <p class="eyebrow">OPS-003</p>
  <h1>First login</h1>
  <p class="lede">Consume the one-time bootstrap token from <code>opentprm init</code>. You will set passwords for both administrators, then be taken to sign in.</p>
</section>
<section class="panel">
  <form id="bootstrap-form" class="stack">
    <label>Bootstrap token
      <input name="token" type="password" autocomplete="off" required placeholder="64-char hex from data/bootstrap.token">
    </label>
    <label>Security Administrator email
      <input name="security_admin_email" type="email" required>
    </label>
    <label>Security Administrator password (min 15)
      <input name="security_admin_password" type="password" required minlength="15" autocomplete="new-password">
    </label>
    <label>System Administrator email
      <input name="system_admin_email" type="email" required>
    </label>
    <label>System Administrator password (min 15)
      <input name="system_admin_password" type="password" required minlength="15" autocomplete="new-password">
    </label>
    <button type="submit" class="btn">Create admins</button>
  </form>
  <pre id="bootstrap-result" class="muted" hidden></pre>
  <p class="note">Token is single-use and expires one hour after init. Emails must differ. After success, sign in at <a href="/login">/login</a>. Optionally enroll a passkey for step-up after you have a session.</p>
</section>
<script src="/static/bootstrap.js"></script>
{{template "footer" .}}{{end}}
