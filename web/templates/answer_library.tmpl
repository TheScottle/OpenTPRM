{{define "answer_library.tmpl"}}{{template "header" .}}
<section class="page">
  <h1>Answer library</h1>
  <p class="lede">Accepted questionnaire answers reusable across vendor assessments (QST-035).</p>
  {{if .VendorID}}
  <p class="meta">Vendor <code>{{.VendorID}}</code>{{if .VendorName}} — {{.VendorName}}{{end}}</p>
  {{end}}

  {{if .CanWrite}}
  <form method="POST" action="/answer-library" class="stack panel">
    {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
    <h2>Upsert answer</h2>
    <label>Vendor ID <input name="vendor_id" type="text" value="{{.VendorID}}" required></label>
    <label>Question key <input name="question_key" type="text" required></label>
    <label>Answer JSON <textarea name="answer_json" required placeholder='"Yes"'></textarea></label>
    <button type="submit" class="btn">Save</button>
  </form>
  {{end}}

  {{if .Entries}}
  <table class="list">
    <thead><tr><th>Question</th><th>Status</th><th>Effective</th><th>Updated</th><th>Answer</th></tr></thead>
    <tbody>
    {{range .Entries}}
      <tr>
        <td><code>{{.QuestionKey}}</code></td>
        <td>{{.Status}}</td>
        <td>{{.EffectiveDate}}</td>
        <td>{{.UpdatedAt}}</td>
        <td class="mono">{{.AnswerJSON}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No library entries{{if .VendorID}} for this vendor{{end}}.</p>
  {{end}}
  {{if .Vendors}}
  <h2>Browse by vendor</h2>
  <ul class="plain">
  {{range .Vendors}}
    <li><a href="/answer-library?vendor_id={{.ID}}">{{.LegalName}}</a></li>
  {{end}}
  </ul>
  {{end}}
</section>
{{template "footer" .}}{{end}}
